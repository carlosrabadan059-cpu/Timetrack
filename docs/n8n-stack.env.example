# Variables de entorno del stack Docker de n8n (Portainer)
# Cómo usar: copiar como n8n-stack.env, rellenar los valores reales
# (sacarlos del compose actual o de un gestor de secretos), y cargarlo
# en Portainer vía "Load variables from .env file" al editar el stack.
# NUNCA commitear n8n-stack.env con valores reales — solo esta plantilla.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

N8N_WEBHOOK_SECRET=

GOOGLE_API_KEY=
GOOGLE_CSE_ID=
OPENAI_API_KEY=

VINOTECA_SUPABASE_URL=
VINOTECA_SUPABASE_SERVICE_KEY=

SETTINGS_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AC_BASE_URL=
AC_API_TOKEN=
AC_USERNAME=
AC_PASSWORD=

NODE_RED_SECRET=

CLOUDFLARE_TUNNEL_TOKEN=
