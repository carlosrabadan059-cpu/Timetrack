# Supabase (obligatorias)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2N Access Commander — solo fallback global/desarrollo: en producción la URL y el
# token de cada empresa se guardan cifrados en company_settings.clocking_modes.
# La reconciliación nocturna sí usa estas dos variables.
AC_BASE_URL=https://access.tudominio.com
AC_API_TOKEN=

# n8n
N8N_WEBHOOK_BASE_URL=https://n8n.tudominio.com
N8N_WEBHOOK_SECRET=
# Opcional: webhook del bot de ayuda
N8N_HELP_WEBHOOK_URL=

# Node-RED (opcional, solo si se usa ese modo)
NODE_RED_SECRET=

# Cifrado de ajustes (openssl rand -hex 32). En producción debe ser SIEMPRE la misma:
# cambiarla impide descifrar los tokens 2N y los secretos guardados en Supabase.
SETTINGS_ENCRYPTION_KEY=

# CORS: orígenes del frontend permitidos, separados por comas (obligatoria en producción)
FRONTEND_URL=https://timetrack.tudominio.com

# Server
PORT=3000
NODE_ENV=development
# APP_VERSION la fija el build (ARG GIT_SHA del Dockerfile); no hace falta definirla.
